&CONTROL
  calculation     = 'scf',
  prefix          = 'NaGeF3',
  pseudo_dir      = '/home/administrator/Downloads/BURAI/BURAI1.3/pseudopot/',
  outdir          = './tmp/',
  etot_conv_thr   = 1.0d-7,
/

&SYSTEM
  ibrav           = 1,
  celldm(1)       = 8.30,         ! 4.393864523 Å / 0.529177 Å·Bohr⁻¹ ≃ 8.30 Bohr
  nat             = 5,
  ntyp            = 3,
  ecutwfc         = 100.0,
  ecutrho         = 800.0,
  input_dft       = 'PBE',
  occupations     = 'smearing',
  smearing        = 'gaussian',
  degauss         = 0.01,
/

&ELECTRONS
  conv_thr        = 1.0d-10,
  mixing_beta     = 0.3,
  diagonalization = 'david',
/

ATOMIC_SPECIES
  Na  22.9898  Na.pbe-spn-kjpaw_psl.1.0.0.UPF
  Ge  72.6300  Ge.pbe-n-kjpaw_psl.1.0.0.UPF
  F   18.9984  F.pbe-n-kjpaw_psl.1.0.0.UPF

ATOMIC_POSITIONS (crystal)
  Na  0.0000000  0.0000000  0.0000000
  Ge  0.5000000  0.5000000  0.5000000
  F   0.5000000  0.5000000  0.0000000
  F   0.5000000  0.0000000  0.5000000
  F   0.0000000  0.5000000  0.5000000

K_POINTS automatic
 10 10 10  0 0 0


