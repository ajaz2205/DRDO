&CONTROL
  calculation     = 'vc-relax',
  restart_mode    = 'from_scratch',
  prefix          = 'kybf3',
  outdir          = './tmp/',
  pseudo_dir      = '/home/administrator/Downloads/BURAI/BURAI1.3/pseudopot/',
  verbosity       = 'high',
  tstress         = .true.,
  tprnfor         = .true.,
  wf_collect      = .true.,
  etot_conv_thr   = 1.0d-7,
  forc_conv_thr   = 1.0d-5,
/

&SYSTEM
  ibrav           = 0,
  nat             = 5,
  ntyp            = 3,
  ecutwfc         = 100.0,
  ecutrho         = 800.0,
  input_dft       = 'PBE',
  occupations = 'smearing',
  smearing    = 'cold',
  degauss     = 0.005,    ! 0.005 Ry ~ 0.07 eV
/

&ELECTRONS
  conv_thr        = 1.0d-12,
  mixing_beta     = 0.3,
  diagonalization = 'david',
/

&IONS
  ion_dynamics    = 'bfgs',
/

&CELL
  cell_dynamics   = 'bfgs',
  press_conv_thr  = 0.1,
/

ATOMIC_SPECIES
  K   39.0983   K.pbe-spn-rrkjus_psl.1.0.0.UPF
  Yb 173.054   Yb.pbe-spdn-rrkjus_psl.1.0.0.UPF
  F   18.9984   F.pbe-n-rrkjus_psl.1.0.0.UPF

CELL_PARAMETERS (angstrom)
  4.058792924   0.000000000   0.000000000
  0.000000000   4.058792924   0.000000000
  0.000000000   0.000000000   4.058792924

ATOMIC_POSITIONS (crystal)
  K   0.0000000  0.0000000  0.0000000
  Yb  0.5000000  0.5000000  0.5000000
  F   0.5000000  0.5000000  0.0000000
  F   0.5000000  0.0000000  0.5000000
  F   0.0000000  0.5000000  0.5000000

K_POINTS automatic
  8 8 8  0 0 0

