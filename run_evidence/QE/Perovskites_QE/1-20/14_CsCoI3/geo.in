  outdir      = './tmp/',
  pseudo_dir  = '/home/administrator/Downloads/BURAI/BURAI1.3/pseudopot/',
  tstress     = .true.,
  tprnfor     = .true.,
  verbosity   = 'high',
/

&SYSTEM
  ibrav       = 0,
  nat         = 5,
  ntyp        = 3,
  ecutwfc     = 80.0,
  ecutrho     = 640.0,
