&CONTROL
  calculation   = 'scf',
  prefix        = 'catis3',
  outdir        = './tmp/',
  pseudo_dir    = '/home/administrator/Downloads/BURAI/BURAI1.3/pseudopot/',
  verbosity     = 'high',
  tstress       = .true.,
  tprnfor       = .true.,
  etot_conv_thr = 1.0d-7,
  forc_conv_thr = 1.0d-6,
  wf_collect    = .true.,
/

&SYSTEM
  ibrav         = 0,
  nat           = 5,
  ntyp          = 3,
  ecutwfc       = 80.0,
  ecutrho       = 640.0,
  occupations = 'smearing',
  smearing    = 'marzari-vanderbilt',
  degauss     = 0.01,
  input_dft     = 'pbe',
/

&ELECTRONS
  conv_thr         = 1.0d-10,
  mixing_beta      = 0.3,
  diagonalization  = 'david',
  electron_maxstep = 2000,
/

ATOMIC_SPECIES
  Ca  40.078   Ca.pbe-spn-kjpaw_psl.1.0.0.UPF
  Ti  47.867   Ti.pbe-spn-rrkjus_psl.1.0.0.UPF
  S   32.06    S.pbe-n-kjpaw_psl.1.0.0.UPF

