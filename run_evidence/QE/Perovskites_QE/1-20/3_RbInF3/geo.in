&CONTROL
  calculation   = 'vc-relax',
  prefix        = 'rbinf3',
  outdir        = './tmp/',
  pseudo_dir    = '/home/administrator/Downloads/BURAI/BURAI1.3/pseudopot/',
  verbosity     = 'high',
  tstress       = .true.,
  tprnfor       = .true.,
  etot_conv_thr = 1.0d-7,
  forc_conv_thr = 1.0d-6,
  disk_io       = 'low',
  wf_collect    = .false.,
/

&SYSTEM
  ibrav         = 0,
  nat           = 5,
  ntyp          = 3,
  ecutwfc       = 80.0,
  ecutrho       = 640.0,
  occupations   = 'smearing',
  smearing      = 'mp',
  degauss       = 0.01,
/

&ELECTRONS
  conv_thr         = 1.0d-10,
  mixing_beta      = 0.3,
  diagonalization  = 'david',
/

&IONS
  ion_dynamics     = 'bfgs',
/

&CELL
  cell_dynamics    = 'bfgs',
  cell_factor      = 1.5,
  press_conv_thr   = 0.1,
  press            = 0.0,
  cell_dofree      = 'all',
/

ATOMIC_SPECIES
  Rb  85.4678   Rb.pbe-spn-kjpaw_psl.1.0.0.UPF
  In  114.818   In.pbe-dn-kjpaw_psl.1.0.0.UPF
  F   18.998    F.pbe-n-kjpaw_psl.1.0.0.UPF

CELL_PARAMETERS angstrom
  4.20021428   0.00000000   0.00000000
  0.00000000   4.20021428   0.00000000
  0.00000000   0.00000000   4.20021428

ATOMIC_POSITIONS crystal
  Rb  0.000000  0.000000  0.000000
  In  0.500000  0.500000  0.500000
  F   0.500000  0.500000  0.000000
  F   0.000000  0.500000  0.500000
  F   0.500000  0.000000  0.500000

K_POINTS automatic
  6 6 6 0 0 0
