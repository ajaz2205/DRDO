&CONTROL
  calculation     = 'vc-relax',
  prefix          = 'agsbs3',
  outdir          = './tmp/',
  pseudo_dir      = '/home/administrator/Downloads/BURAI/BURAI1.3/pseudopot/',
  verbosity       = 'high',
  tstress         = .true.,
  tprnfor         = .true.,
  etot_conv_thr   = 1.0d-8,
  forc_conv_thr   = 1.0d-4,
/

&SYSTEM
  ibrav           = 0,
  nat             = 5,
  ntyp            = 3,
  ecutwfc         = 100.0,
  ecutrho         = 800.0,
  input_dft       = 'PBE',
  occupations     = 'fixed',
/

&ELECTRONS
  conv_thr        = 1.0d-12,
  mixing_beta     = 0.3,
  diagonalization = 'david',
/

&IONS
  ion_dynamics    = 'bfgs',
/

&CELL
  cell_dynamics   = 'bfgs',
  press           = 0.0,
/

