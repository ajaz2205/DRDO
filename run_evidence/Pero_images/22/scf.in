&CONTROL
  calculation       = 'scf',
  prefix            = 'CsZnCl3',
  pseudo_dir        = '/home/administrator/Downloads/BURAI/BURAI1.3/pseudopot/',
  outdir            = './tmp/',
  wf_collect        = .true.,
  etot_conv_thr     = 1.0d-8,
/

&SYSTEM
  ibrav            = 0,
  nat              = 5,
  ntyp             = 3,
  ecutwfc          = 100.0,
  ecutrho          = 800.0,
  input_dft        = 'PBE',
  occupations      = 'smearing',
  smearing         = 'gaussian',
  degauss          = 0.005,
  nosym            = .false.,    ! use symmetry for SCF speed
  noinv            = .false.,
/

&ELECTRONS
  conv_thr         = 1.0d-12,
  mixing_beta      = 0.3,
  diagonalization  = 'david',
/

CELL_PARAMETERS (angstrom)
  5.057378339  0.000000000  0.000000000
  0.000000000  5.057378339  0.000000000
  0.000000000  0.000000000  5.057378339

ATOMIC_SPECIES
  Cs  132.9055   Cs.pbe-spn-rrkjus_psl.1.0.0.UPF
  Zn   65.3800   Zn.pbe-spn-kjpaw_psl.1.0.0.UPF
  Cl   35.4530   Cl.pbe-n-kjpaw_psl.1.0.0.UPF

ATOMIC_POSITIONS (crystal)
  Cs  0.0000000  0.0000000  0.0000000
  Zn  0.5000000  0.5000000  0.5000000
  Cl  0.5000000  0.5000000  0.0000000
  Cl  0.5000000  0.0000000  0.5000000
  Cl  0.0000000  0.5000000  0.5000000

K_POINTS automatic
 10 10 10  0 0 0

