&CONTROL
  calculation       = 'vc-relax',
  prefix            = 'CsNbSe3',
  pseudo_dir      = '/home/administrator/Downloads/BURAI/BURAI1.3/pseudopot/',
  outdir            = './tmp/',
  tstress           = .true.,
  tprnfor           = .true.,
  wf_collect        = .true.,
  etot_conv_thr     = 1.0d-7,
  forc_conv_thr     = 1.0d-5,
/

&SYSTEM
  ibrav            = 0,
  nat              = 5,
  ntyp             = 3,
  ecutwfc          = 100.0,
  ecutrho          = 800.0,
  input_dft        = 'PBE',
  occupations      = 'smearing',
  smearing         = 'gaussian',
  degauss          = 0.01,
/

&ELECTRONS
  conv_thr         = 1.0d-12,
  mixing_beta      = 0.3,
  diagonalization  = 'david',
/

&IONS
  ion_dynamics     = 'bfgs',
/

&CELL
  cell_dynamics    = 'bfgs',
  press_conv_thr   = 0.1,
/

