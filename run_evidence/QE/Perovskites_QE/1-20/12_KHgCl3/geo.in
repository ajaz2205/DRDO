&CONTROL
  calculation = 'vc-relax',
  prefix = 'khgcl3',
  outdir = './tmp/',
  pseudo_dir = '/home/administrator/Downloads/BURAI/BURAI1.3/pseudopot/',
  tstress = .true.,
  tprnfor = .true.,
  verbosity = 'high',
/

&SYSTEM
  ibrav = 0,
  nat = 5,
  ntyp = 3,
  ecutwfc = 80.0,
  ecutrho = 640.0,
  input_dft = 'PBE',
  occupations = 'smearing',
  smearing = 'gaussian',
  degauss = 0.005,
/

&ELECTRONS
  conv_thr = 1.0d-8,
  mixing_beta = 0.4,
/

&IONS
  ion_dynamics = 'bfgs',
/

&CELL
  cell_dynamics = 'bfgs',
  press_conv_thr = 0.5,
/

