  calculation   = 'scf',
  prefix        = 'rbinf3',
  outdir        = './tmp/',
  pseudo_dir    = '/home/administrator/Downloads/BURAI/BURAI1.3/pseudopot/',
  verbosity     = 'high',
/

&SYSTEM
  ibrav         = 0,
  nat           = 5,
  ntyp          = 3,
