&CONTROL
  calculation   = 'scf',
  prefix        = 'catis3_elastic_XXp',
  outdir        = './tmp_elastic_XXp/',
  pseudo_dir    = '/home/administrator/Downloads/BURAI/BURAI1.3/pseudopot/',
  verbosity     = 'high',
  tstress       = .true.,
  tprnfor       = .false.,
  etot_conv_thr = 1.0d-9,
  forc_conv_thr = 1.0d-6,
  wf_collect    = .true.,
/

&SYSTEM
  ibrav         = 0,
  nat           = 5,
  ntyp          = 3,
  ecutwfc       = 80.0,
  ecutrho       = 640.0,
  occupations   = 'smearing',
  smearing      = 'gaussian',
  degauss       = 0.002,
  input_dft     = 'pbe',
/

&ELECTRONS
  conv_thr         = 1.0d-10,
  mixing_beta      = 0.3,
  diagonalization  = 'david',
/

ATOMIC_SPECIES
  Ca  40.078   Ca.pbe-spn-kjpaw_psl.1.0.0.UPF
  Ti  47.867   Ti.pbe-spn-kjpaw_psl.1.0.0.UPF
  Se  78.971   Se.pbe-n-kjpaw_psl.1.0.0.UPF

CELL_PARAMETERS (angstrom)
  5.306611658   0.000000000   0.000000000
  0.000000000   5.280210605   0.000000000
  0.000000000   0.000000000   5.280210605

ATOMIC_POSITIONS crystal
  Ca  0.0000000000  0.0000000000  0.0000000000
  Ti  0.5000000000  0.5000000000  0.5000000000
  Se  0.5000000000  0.0000000000  0.0000000000
  Se  0.0000000000  0.5000000000  0.0000000000
  Se  0.0000000000  0.0000000000  0.5000000000

K_POINTS automatic
  4 4 4 0 0 0
