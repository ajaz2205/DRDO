&inputph
  prefix       = 'RbSbSe3',
  outdir       = './tmp/',
  fildyn       = 'RbSbSe3.dynG',
  ldisp        = .false.,      ! Γ-point only
  epsil        = .false.,      ! no LO-TO splitting
  trans        = .true.,       ! enforce translational invariance
  tr2_ph       = 1.0d-12,      ! tight convergence on dynamical matrix
  alpha_mix(1) = 0.5,          ! gentle mixing for response
  reduce_io    = .true.,       ! slim down I/O
  verbosity    = 'high',
  amass(1)     = 85.4678,      ! Rb
  amass(2)     = 121.7600,     ! Sb
  amass(3)     = 78.9710,      ! Se
/
0.0 0.0 0.0

