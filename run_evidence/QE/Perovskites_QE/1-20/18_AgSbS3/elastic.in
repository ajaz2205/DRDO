&CONTROL
  calculation     = 'scf',
  prefix          = 'agsbs3',
  outdir          = './tmp/',
  pseudo_dir      = '/home/administrator/Downloads/BURAI/BURAI1.3/pseudopot/',
  verbosity       = 'high',
  tstress         = .true.,
  tprnfor         = .true.,
/

&SYSTEM
  ibrav           = 0,
  nat             = 5,
  ntyp            = 3,
  ecutwfc         = 100.0,
  ecutrho         = 800.0,
  input_dft       = 'PBE',
  occupations = 'smearing',
  smearing    = 'gaussian',
  degauss     = 0.01,   ! 0.01–0.02 Ry is a good starting point
/

/

&ELECTRONS
  conv_thr        = 1.0d-10,
  mixing_beta     = 0.3,
  diagonalization = 'david',
/

ATOMIC_SPECIES
  Ag  107.868  Ag.pbe-n-rrkjus_psl.1.0.0.UPF
  Sb  121.760  Sb.pbe-n-rrkjus_psl.1.0.0.UPF
  S    32.065  S.pbe-n-kjpaw_psl.1.0.0.UPF

CELL_PARAMETERS angstrom
   5.062885299   0.000000000   0.000000000
   0.000000000   5.062885299   0.000000000
   0.000000000   0.000000000   5.062885299

ATOMIC_POSITIONS crystal
  Ag  0.0000000000  0.0000000000  0.0000000000
  Sb  0.5000000000  0.5000000000  0.5000000000
  S   0.5000000000  0.5000000000  0.0000000000
  S   0.5000000000  0.0000000000  0.5000000000
  S   0.0000000000  0.5000000000  0.5000000000

K_POINTS automatic
  10 10 10  0 0 0

