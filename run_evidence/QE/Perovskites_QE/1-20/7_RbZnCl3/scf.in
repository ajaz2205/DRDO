&CONTROL
  calculation   = 'scf',
  prefix        = 'rbzncl3',
  outdir        = './tmp/',
  pseudo_dir    = '/home/administrator/Downloads/BURAI/BURAI1.3/pseudopot/',
  tstress       = .true.,
  tprnfor       = .true.,
  verbosity     = 'high',
  etot_conv_thr = 1.0d-8,
/

&SYSTEM
  ibrav         = 0,
  nat           = 5,
  ntyp          = 3,
  ecutwfc       = 100.0,
  ecutrho       = 800.0,
  occupations   = 'fixed',
  input_dft     = 'pbe',
/

&ELECTRONS
  conv_thr       = 1.0d-10,
  mixing_beta    = 0.3,
  diagonalization = 'david',
/

