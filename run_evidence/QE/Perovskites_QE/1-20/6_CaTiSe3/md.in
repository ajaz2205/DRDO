&CONTROL
  calculation = 'cp',
  restart_mode = 'from_scratch',
  prefix = 'catis3_md',
  outdir = './tmp/',
  pseudo_dir = '/home/administrator/Downloads/BURAI/BURAI1.3/pseudopot/',  
  nstep = 4000,
  dt = 10,                      ! ⬅️ safer time step (0.72 fs)
  iprint = 100,
  isave = 500,
  wf_collect = .true.,
  tstress = .true.,
  tprnfor = .false.,
/

&SYSTEM
  ibrav = 0,
  nat = 40,
  ntyp = 3,
  ecutwfc = 50.0,               ! ⬅️ Slightly reduced
  ecutrho = 400.0,              ! ⬅️ 8× ratio
  occupations = 'fixed',
  input_dft = 'PBE',
  nr1b = 48,
  nr2b = 48,
  nr3b = 48,
/

&ELECTRONS
  electron_dynamics = 'verlet',
  emass = 300.0,                ! ⬅️ Reduced from 400 → 150
  conv_thr = 1.0d-5,            ! ⬅️ Slightly looser
  electron_damping = 0.1
/

&IONS
  ion_temperature = 'nose',
  tempw = 300.0,
  fnosep = 100.0,
/

