&inputph
  prefix       = 'RbNiI3',
  outdir       = './tmp/',
  fildyn       = 'RbNiI3.dynG',
  ldisp        = .false.,      ! Γ-point only
  epsil        = .false.,      ! no LO–TO splitting for stability check
  trans        = .true.,       ! enforce translational invariance
  tr2_ph       = 1.0d-14,      ! very tight convergence on dynamical matrix
  alpha_mix(1) = 0.5,          ! gentle mixing for response
  reduce_io    = .true.,       ! slim down I/O
  verbosity    = 'high',
  amass(1)     = 85.4678,      ! Rb
  amass(2)     = 58.6934,      ! Ni
  amass(3)     = 126.9045,     ! I
/
0.0 0.0 0.0

