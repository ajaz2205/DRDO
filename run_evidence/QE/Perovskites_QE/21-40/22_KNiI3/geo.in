&CONTROL
  calculation     = 'vc-relax',
  restart_mode    = 'from_scratch',
  prefix          = 'knii3',
  outdir          = './tmp/',
  pseudo_dir      = '/home/administrator/Downloads/BURAI/BURAI1.3/pseudopot/',
  verbosity       = 'high',
  tstress         = .true.,
  tprnfor         = .true.,
  wf_collect      = .true.,
  etot_conv_thr   = 1.0d-7,
  forc_conv_thr   = 1.0d-5,
/

&SYSTEM
  ibrav           = 0,
  nat             = 5,
  ntyp            = 3,
  ecutwfc         = 100.0,
  ecutrho         = 800.0,
  input_dft       = 'PBE',
  occupations     = 'fixed',
/

&ELECTRONS
  conv_thr        = 1.0d-12,
  mixing_beta     = 0.3,
  diagonalization = 'david',
/

&IONS
  ion_dynamics    = 'bfgs',
/

&CELL
  cell_dynamics      = 'bfgs',
  press_conv_thr     = 0.1,
/

ATOMIC_SPECIES
  K   39.0983    K.pbe-spn-rrkjus_psl.1.0.0.UPF
  Ni  58.6934    Ni.pbe-spn-rrkjus_psl.1.0.0.UPF
  I   126.9045   I.pbe-dn-kjpaw_psl.1.0.0.UPF

