&CONTROL
  calculation       = 'scf',
  prefix            = 'AgGeBr3',
  pseudo_dir        = '/home/administrator/Downloads/BURAI/BURAI1.3/pseudopot/',
  outdir            = './tmp/',
  etot_conv_thr     = 1.0d-6,
/

&SYSTEM
  ibrav            = 0,
  nat              = 5,
  ntyp             = 3,
  ecutwfc          = 100.0,
  ecutrho          = 800.0,
  input_dft        = 'PBE',
  occupations      = 'smearing',
  smearing         = 'gaussian',
  degauss          = 0.005,
/

&ELECTRONS
  conv_thr         = 1.0d-10,
  mixing_beta      = 0.3,
  diagonalization  = 'david',
/

CELL_PARAMETERS angstrom
  5.410246890  0.000000000  0.000000000
  0.000000000  5.410246890  0.000000000
  0.000000000  0.000000000  5.410246890

