&CONTROL
  calculation   = 'vc-relax',
  prefix        = 'catis3',
  outdir        = './tmp/',
  pseudo_dir    = '/home/administrator/Downloads/BURAI/BURAI1.3/pseudopot/',
  verbosity     = 'high',
  tstress       = .true.,
  tprnfor       = .true.,
  etot_conv_thr = 1.0d-7,
  forc_conv_thr = 1.0d-6,
/

&SYSTEM
  ibrav         = 0,
  nat           = 5,
  ntyp          = 3,
  ecutwfc       = 80.0,
  ecutrho       = 640.0,
  occupations   = 'smearing',
  smearing      = 'gaussian',     
  degauss       = 0.002,
  input_dft     = 'pbe',
/

&ELECTRONS
  conv_thr         = 1.0d-10,
  mixing_beta      = 0.3,
  diagonalization  = 'david',
/

&IONS
  ion_dynamics     = 'bfgs',
/

&CELL
  cell_dynamics    = 'bfgs',
  cell_factor      = 1.5,
  press_conv_thr   = 0.1,
  press            = 0.0,
  cell_dofree      = 'all',
/

ATOMIC_SPECIES
  Ca  40.078   Ca.pbe-spn-kjpaw_psl.1.0.0.UPF
  Ti  47.867   Ti.pbe-spn-kjpaw_psl.1.0.0.UPF
  Se  78.971   Se.pbe-n-kjpaw_psl.1.0.0.UPF

CELL_PARAMETERS angstrom
  5.586143571   0.000000000   0.000000000
  0.000000000   5.586143571   0.000000000
  0.000000000   0.000000000   5.586143571

ATOMIC_POSITIONS crystal
  Ca  0.000000  0.000000  0.000000
  Ti  0.500000  0.500000  0.500000
  Se  0.500000  0.000000  0.000000
  Se  0.000000  0.500000  0.000000
  Se  0.000000  0.000000  0.500000

K_POINTS automatic
  6 6 6 0 0 0
