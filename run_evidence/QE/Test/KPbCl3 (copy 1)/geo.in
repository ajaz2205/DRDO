&CONTROL
  calculation   = 'vc-relax',
  prefix        = 'kpbc',
  outdir        = './output/',
  pseudo_dir    = '/home/administrator/Downloads/BURAI/BURAI1.3/pseudopot/',
  verbosity     = 'high',
  tstress       = .true.,
  tprnfor       = .true.,
  etot_conv_thr = 1.0d-5,
  forc_conv_thr = 1.0d-4,
/

&SYSTEM
  ibrav         = 0,
  nat           = 5,
  ntyp          = 3,
  ecutwfc       = 80.0,
  ecutrho       = 640.0,
  occupations   = 'smearing',
  smearing      = 'mv',
  degauss       = 0.005,
  nosym         = .true.,
/

&ELECTRONS
  conv_thr      = 1.0d-8,
  mixing_beta   = 0.3,
  diagonalization = 'david',
/

&IONS
  ion_dynamics  = 'bfgs',
/

&CELL
  cell_dynamics = 'bfgs',
  press_conv_thr = 0.5,
  cell_factor    = 2.0,
/

ATOMIC_SPECIES
  K   39.0983   K.pbe-spn-kjpaw_psl.1.0.0.UPF
  Pb  207.2     Pb.pbe-dn-kjpaw_psl.1.0.0.UPF
  Cl  35.453    Cl.pbe-n-rrkjus_psl.1.0.0.UPF

CELL_PARAMETERS angstrom
  4.695189027   0.000000000   0.000000000
  0.000000000   4.695189027   0.000000000
  0.000000000   0.000000000   4.695189027

ATOMIC_POSITIONS crystal
  K   0.000000  0.000000  0.000000
  Pb  0.500000  0.500000  0.500000
  Cl  0.500000  0.500000  0.000000
  Cl  0.000000  0.500000  0.500000
  Cl  0.500000  0.000000  0.500000

K_POINTS automatic
  6 6 6 0 0 0
