&CONTROL
  calculation   = 'vc-relax',
  prefix        = 'laals3',
  outdir        = './tmp/',
  pseudo_dir    = '/home/administrator/Downloads/BURAI/BURAI1.3/pseudopot/',
  verbosity     = 'high',
  tstress       = .true.,
  tprnfor       = .true.,
  etot_conv_thr = 1.0d-8,
  forc_conv_thr = 1.0d-4,
/

&SYSTEM
  ibrav     = 0,
  nat       = 5,
  ntyp      = 3,
  ecutwfc   = 100.0,
  ecutrho   = 800.0,
  occupations = 'fixed',
  nbnd      = 40,          !  (≈ 2× #electrons/2, safe margin)
  input_dft = 'PBE',
/

&ELECTRONS
  conv_thr        = 1.0d-9,
  mixing_mode     = 'plain',
  mixing_beta     = 0.3,
  diagonalization = 'david',
/

&IONS
  ion_dynamics = 'bfgs',
/

&CELL
  cell_dynamics = 'bfgs',
  press         = 0.0,
/

ATOMIC_SPECIES
  La  138.90547  La.pbe-spfn-rrkjus_psl.1.0.0.UPF
  Al   26.98154  Al.pbe-n-rrkjus_psl.1.0.0.UPF
  S    32.06500  S.pbe-n-kjpaw_psl.1.0.0.UPF

CELL_PARAMETERS angstrom
  4.29920923   0.00000000   0.00000000
  0.00000000   4.29920923   0.00000000
  0.00000000   0.00000000   4.29920923

ATOMIC_POSITIONS crystal
  La  0.0000000  0.0000000  0.0000000
  Al  0.5000000  0.5000000  0.5000000
   S  0.5000000  0.5000000  0.0000000
   S  0.5000000  0.0000000  0.5000000
   S  0.0000000  0.5000000  0.5000000

K_POINTS automatic
  8 8 8  0 0 0

