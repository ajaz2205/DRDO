&CONTROL
  calculation       = 'scf',
  prefix            = 'AgGeI3',
  pseudo_dir        = '/home/administrator/Downloads/BURAI/BURAI1.3/pseudopot/',
  outdir            = './tmp/',
  wf_collect        = .true.,
  etot_conv_thr     = 1.0d-8,
/

&SYSTEM
  ibrav            = 0,
  nat              = 5,
  ntyp             = 3,
  ecutwfc          = 100.0,
  ecutrho          = 800.0,
  input_dft        = 'PBE',
  occupations      = 'smearing',
  smearing         = 'gaussian',
  degauss          = 0.005,
  nosym            = .false.,    ! use symmetry for SCF speed
  noinv            = .false.,
/

&ELECTRONS
  conv_thr         = 1.0d-12,
  mixing_beta      = 0.3,
  diagonalization  = 'david',
/

